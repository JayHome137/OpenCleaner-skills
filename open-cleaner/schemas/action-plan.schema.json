{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-cleaner.local/schemas/action-plan.schema.json",
  "title": "OpenCleaner action plan",
  "type": "object",
  "required": [
    "schema_version",
    "purpose",
    "dry_run",
    "plan_id",
    "generated_at",
    "expires_at",
    "platform",
    "home",
    "source_analysis_sha256",
    "actions",
    "rejected",
    "decision"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "purpose": {"enum": ["dry-run", "session"]},
    "dry_run": {"type": "boolean"},
    "plan_id": {"type": "string", "minLength": 16},
    "generated_at": {"type": "string"},
    "expires_at": {"type": "string"},
    "platform": {"const": "darwin"},
    "home": {"type": "string"},
    "source_analysis_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action_id",
          "mode",
          "path",
          "canonical_path",
          "tier",
          "rule_id",
          "recovery",
          "risk",
          "non_targets",
          "identity",
          "parent_identity"
          ,"size_estimate_bytes"
        ],
        "properties": {
          "action_id": {"type": "string", "minLength": 16},
          "mode": {"enum": ["open", "trash", "reviewed_trash"]},
          "path": {"type": "string"},
          "canonical_path": {"type": "string"},
          "tier": {"enum": ["green", "yellow", "red"]},
          "rule_id": {"type": "string"},
          "recovery": {"type": "string"},
          "risk": {"type": "string"},
          "non_targets": {"type": "array", "items": {"type": "string"}},
          "size_estimate_bytes": {"type": "integer", "minimum": 0},
          "identity": {
            "type": "object",
            "required": ["device", "inode", "mode", "kind", "size", "mtime_ns"],
            "properties": {
              "device": {"type": "integer"},
              "inode": {"type": "integer"},
              "mode": {"type": "integer"},
              "kind": {"enum": ["file", "directory"]},
              "size": {"type": "integer", "minimum": 0},
              "mtime_ns": {"type": "integer"}
            },
            "additionalProperties": false
          },
          "parent_identity": {
            "type": "object",
            "required": ["device", "inode", "mode", "kind", "size", "mtime_ns"],
            "properties": {
              "device": {"type": "integer", "minimum": 0},
              "inode": {"type": "integer", "minimum": 0},
              "mode": {"type": "integer", "minimum": 0},
              "kind": {"const": "directory"},
              "size": {"type": "integer", "minimum": 0},
              "mtime_ns": {"type": "integer"}
            },
            "additionalProperties": false
          },
          "runtime": {
            "type": "object",
            "required": ["id", "processes", "owner_tool", "state"],
            "properties": {
              "id": {"type": "string"},
              "processes": {"type": "array", "items": {"type": "string"}},
              "owner_tool": {"type": "object"},
              "state": {"enum": ["active", "inactive", "unknown"]}
            }
          },
          "project": {
            "type": "object",
            "required": ["project_root", "artifact_kind", "idle_seconds", "latest_mtime_ns"],
            "properties": {
              "project_root": {"type": "string"},
              "artifact_kind": {"type": "string"},
              "build_system": {"type": "string"},
              "idle_seconds": {"type": "integer", "minimum": 1800},
              "latest_mtime_ns": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    },
    "rejected": {
      "type": "array",
      "items": {"$ref": "#/$defs/rejected"}
    },
    "decision": {
      "type": "object",
      "required": ["discovery", "actionable", "blocked"],
      "properties": {
        "discovery": {"$ref": "#/$defs/discovery"},
        "actionable": {"$ref": "#/$defs/actionable"},
        "blocked": {
          "type": "object",
          "required": ["count", "size_bytes", "reasons"],
          "properties": {
            "count": {"type": "integer", "minimum": 0},
            "size_bytes": {"type": "integer", "minimum": 0},
            "reasons": {
              "type": "array",
              "items": {"$ref": "#/$defs/reason"}
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "bucket": {
      "type": "object",
      "required": ["count", "size_bytes"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "size_bytes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "discovery": {
      "type": "object",
      "required": ["green", "yellow", "red"],
      "properties": {
        "green": {"$ref": "#/$defs/bucket"},
        "yellow": {"$ref": "#/$defs/bucket"},
        "red": {"$ref": "#/$defs/bucket"}
      },
      "additionalProperties": false
    },
    "actionable": {
      "type": "object",
      "required": ["trash", "reviewed_trash", "open"],
      "properties": {
        "trash": {"$ref": "#/$defs/bucket"},
        "reviewed_trash": {"$ref": "#/$defs/bucket"},
        "open": {"$ref": "#/$defs/bucket"}
      },
      "additionalProperties": false
    },
    "rejected": {
      "type": "object",
      "required": ["path", "mode", "code", "message", "size_estimate_bytes"],
      "properties": {
        "path": {"type": "string"},
        "mode": {"enum": ["open", "trash", "reviewed_trash"]},
        "code": {"type": "string"},
        "message": {"type": "string"},
        "name": {"type": "string"},
        "size_estimate_bytes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "reason": {
      "type": "object",
      "required": ["code", "message", "count", "size_bytes"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"},
        "count": {"type": "integer", "minimum": 0},
        "size_bytes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
