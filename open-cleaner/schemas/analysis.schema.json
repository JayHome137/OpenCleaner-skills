{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-cleaner.local/schemas/analysis.schema.json",
  "title": "OpenCleaner analysis",
  "type": "object",
  "required": [
    "schema_version",
    "source_scan_sha256",
    "generated_at",
    "system",
    "top5",
    "green",
    "yellow",
    "red",
    "summary"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source_scan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "generated_at": {"type": "string"},
    "scan_seconds": {"type": "number", "minimum": 0},
    "system": {
      "type": "object",
      "required": ["os", "home"],
      "properties": {"os": {"type": "string"}, "home": {"type": "string"}}
    },
    "top5": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rank", "tier", "size", "type", "name", "path", "note"],
        "properties": {
          "rank": {"type": "integer", "minimum": 1},
          "tier": {"enum": ["green", "yellow", "red"]},
          "size": {"type": "string"},
          "type": {"type": "string"},
          "name": {"type": "string"},
          "path": {"type": "string"},
          "note": {"type": "string"}
        }
      }
    },
    "green": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name", "path", "size_estimate", "kill_processes", "trash_paths", "commands",
          "rule_id", "rule_reason", "rule_risk", "rule_non_targets"
        ],
        "properties": {
          "name": {"type": "string"},
          "path": {"type": "string"},
          "size_estimate": {"type": "string"},
          "kill_processes": {"type": "array", "items": {"type": "string"}},
          "trash_paths": {"type": "array", "items": {"type": "string"}},
          "commands": {"type": "array"},
          "rule_id": {"type": "string"},
          "rule_reason": {"type": "string"},
          "rule_risk": {"type": "string"},
          "rule_non_targets": {"type": "array", "items": {"type": "string"}}
          ,"runtime": {"$ref": "#/$defs/runtimeProfile"}
          ,"ownership": {"$ref": "#/$defs/ownership"}
          ,"protected": {"type": "boolean"}
        }
      }
    },
    "yellow": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path", "size", "content_profile", "why_manual", "disposal", "risk"],
        "properties": {
          "name": {"type": "string"},
          "path": {"type": "string"},
          "size": {"type": "string"},
          "content_profile": {"type": "string"},
          "why_manual": {"type": "string"},
          "disposal": {"type": "string"},
          "risk": {"type": "string"},
          "trash_paths": {"type": "array", "items": {"type": "string"}}
          ,"runtime": {"$ref": "#/$defs/runtimeProfile"}
          ,"ownership": {"$ref": "#/$defs/ownership"}
          ,"protected": {"type": "boolean"}
          ,"reviewed_trash_paths": {"type": "array", "items": {"type": "string"}}
          ,"stage_status": {
            "type": "object",
            "required": ["state", "code"],
            "properties": {
              "state": {"enum": ["ready", "deferred"]},
              "code": {"type": "string"}
            },
            "additionalProperties": false
          }
          ,"project_artifact": {
            "type": "object",
            "required": ["project_root", "artifact_kind", "build_system", "idle_seconds", "latest_mtime_ns"],
            "properties": {
              "project_root": {"type": "string"},
              "artifact_kind": {"type": "string"},
              "build_system": {"type": "string"},
              "idle_seconds": {"type": "integer", "minimum": 1800},
              "latest_mtime_ns": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          }
        }
      }
    },
    "red": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path", "size", "why_keep", "indirect_release", "auto_reclaim"],
        "properties": {
          "name": {"type": "string"},
          "path": {"type": "string"},
          "size": {"type": "string"},
          "why_keep": {"type": "string"},
          "indirect_release": {"type": "string"},
          "auto_reclaim": {"type": "string"},
          "app_paths": {"type": "array", "items": {"type": "string"}},
          "ownership": {"$ref": "#/$defs/ownership"},
          "protected": {"type": "boolean"}
        }
      }
    },
    "installer_packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name", "path", "format", "size_bytes", "installed_state", "installed_apps",
          "source", "last_used_at", "unique_copy_risk", "duplicates"
        ],
        "properties": {
          "name": {"type": "string"},
          "path": {"type": "string"},
          "format": {"enum": ["DMG", "PKG", "ISO", "XIP", "ZIP"]},
          "size_bytes": {"type": "integer", "minimum": 0},
          "installed_state": {"type": "string"},
          "installed_apps": {"type": "array", "items": {"type": "string"}},
          "source": {"type": "string"},
          "last_used_at": {"type": "string"},
          "unique_copy_risk": {"type": "string"},
          "duplicates": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "denied": {"type": "array", "items": {"type": "string"}},
    "analysis_origin": {"enum": ["deterministic-draft", "project-stage"]},
    "project_stage": {
      "type": "object",
      "required": ["discovered", "actionable", "actionable_size", "idle_minutes", "min_kb"],
      "properties": {
        "discovered": {"type": "integer", "minimum": 0},
        "actionable": {"type": "integer", "minimum": 0},
        "actionable_size": {"type": "string"},
        "idle_minutes": {"type": "integer", "minimum": 0},
        "min_kb": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["overview", "tier_stats", "priority", "long_term"],
      "properties": {
        "overview": {"type": "string"},
        "tier_stats": {
          "type": "object",
          "required": ["green", "yellow", "red"],
          "properties": {
            "green": {"type": "string"},
            "yellow": {"type": "string"},
            "red": {"type": "string"}
          }
        },
        "priority": {"type": "array", "items": {"type": "string"}},
        "long_term": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "ownership": {
      "type": "object",
      "required": [
        "bundle_id", "display_name", "app_paths", "relationships", "login_items",
        "background_processes", "shared_bundle_id", "multiple_versions"
      ],
      "properties": {
        "bundle_id": {"type": "string"},
        "display_name": {"type": "string"},
        "app_paths": {"type": "array", "items": {"type": "string"}},
        "relationships": {"type": "array", "items": {"type": "string"}},
        "login_items": {"type": "array", "items": {"type": "string"}},
        "background_processes": {"type": "array", "items": {"type": "string"}},
        "shared_bundle_id": {"type": "boolean"},
        "multiple_versions": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "runtimeProfile": {
      "type": "object",
      "required": ["id", "processes", "owner_tool"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "processes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "owner_tool": {
          "type": "object",
          "required": ["name", "inspect_command", "cleanup_command", "execution"],
          "properties": {
            "name": {"type": "string"},
            "inspect_command": {"type": "string"},
            "cleanup_command": {"type": "string"},
            "execution": {"enum": ["review-only", "app-managed"]}
          }
        }
      }
    }
  },
  "additionalProperties": true
}
