{
  "schema_version": "1.0",
  "rules": [
    {
      "id": "common.user-cache-entry",
      "platforms": ["darwin"],
      "root": "${HOME}/.cache",
      "min_depth": 1,
      "actions": ["trash"],
      "classification": "green",
      "recovery": "应用或工具会在下次使用时重新生成缓存。",
      "risk": "首次重新打开相关工具时可能需要重新下载或重新计算内容。",
      "non_targets": [".cache 根目录本身", "凭据、密钥和用户配置目录", "符号链接目标"],
      "blocked_components": ["credentials", "secrets", "keychains"]
    },
    {
      "id": "common.npm-content-cache",
      "platforms": ["darwin"],
      "root": "${HOME}/.npm/_cacache",
      "min_depth": 0,
      "actions": ["trash"],
      "classification": "green",
      "recovery": "npm 会按需重新下载包内容。",
      "risk": "后续安装依赖需要重新下载，离线环境中可能暂时不可用。",
      "non_targets": ["~/.npmrc", "npm 登录凭据", "_cacache 之外的 npm 配置和日志"],
      "blocked_components": []
    },
    {
      "id": "common.gradle-cache-entry",
      "platforms": ["darwin"],
      "root": "${HOME}/.gradle/caches",
      "min_depth": 1,
      "actions": ["trash"],
      "classification": "green",
      "recovery": "Gradle 会重新生成构建缓存并重新下载依赖。",
      "risk": "下一次构建会变慢，并可能需要网络重新获取依赖。",
      "non_targets": ["~/.gradle/gradle.properties", "Gradle 凭据", "caches 根目录本身"],
      "blocked_components": ["credentials", "secrets"]
    },
    {
      "id": "common.go-module-cache",
      "platforms": ["darwin"],
      "root": "${HOME}/go/pkg/mod",
      "min_depth": 0,
      "actions": ["trash"],
      "classification": "green",
      "recovery": "Go 会按 go.mod 和 go.sum 从模块代理或源仓库重新下载依赖。",
      "risk": "下一次构建需要联网重新下载模块；离线或已下线的私有模块可能暂时无法恢复。",
      "non_targets": ["Go 项目源码", "go.mod 和 go.sum", "~/go/bin", "~/go/src"],
      "blocked_components": []
    },
    {
      "id": "common.codex-cache",
      "platforms": ["darwin"],
      "root": "${HOME}/.codex/cache",
      "min_depth": 0,
      "actions": ["trash"],
      "classification": "green",
      "recovery": "Codex 会重新获取工具目录和远端索引缓存。",
      "risk": "Codex 下一次启动或刷新插件时会变慢，并需要网络。",
      "non_targets": ["Codex sessions", "worktrees", "memories", "skills", "配置和认证数据"],
      "blocked_components": []
    },
    {
      "id": "common.codex-bundled-marketplaces-temp",
      "platforms": ["darwin"],
      "root": "${HOME}/.codex/.tmp/bundled-marketplaces",
      "min_depth": 0,
      "actions": ["trash"],
      "classification": "green",
      "recovery": "Codex 会重新同步内置 marketplace 临时副本。",
      "risk": "下一次插件目录刷新需要重新同步，并可能依赖网络。",
      "non_targets": ["插件备份", "已安装插件数据", "Codex sessions", "worktrees"],
      "blocked_components": []
    },
    {
      "id": "common.codex-plugins-temp",
      "platforms": ["darwin"],
      "root": "${HOME}/.codex/.tmp/plugins",
      "min_depth": 0,
      "actions": ["trash"],
      "classification": "green",
      "recovery": "Codex 会重新同步插件临时仓库。",
      "risk": "下一次插件刷新会变慢，并可能依赖网络。",
      "non_targets": ["plugins-backup-* 备份", "已安装插件数据", "Codex sessions", "worktrees"],
      "blocked_components": []
    },
    {
      "id": "common.codex-plugin-cache",
      "platforms": ["darwin"],
      "root": "${HOME}/.codex/plugins/cache",
      "min_depth": 0,
      "actions": ["trash"],
      "classification": "green",
      "recovery": "Codex 会按需重新下载已发布的插件缓存。",
      "risk": "插件首次重新加载会变慢，并需要网络重新下载。",
      "non_targets": ["插件数据", "插件配置", "安装暂存目录", "Codex sessions 和 worktrees"],
      "blocked_components": []
    },
    {
      "id": "common.claude-cache",
      "platforms": ["darwin"],
      "root": "${HOME}/.claude/cache",
      "min_depth": 0,
      "actions": ["trash"],
      "classification": "green",
      "recovery": "Claude 会按需重新生成命令和工具缓存。",
      "risk": "Claude 下一次启动或使用相关工具时会变慢。",
      "non_targets": ["Claude projects", "sessions", "tasks", "backups", "插件和配置"],
      "blocked_components": []
    }
  ]
}
